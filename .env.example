# ==============================================================================
# Telegram Shop Bot Environment Configuration
# Copy this file to .env and replace with your actual values:
# cp .env.example .env
# ==============================================================================

# Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Database URL (Defaults to SQLite in local directory)
# For SQLite: sqlite:///shop_bot.db
# For PostgreSQL: postgresql://user:password@localhost:5432/shop_bot
DATABASE_URL=sqlite:///shop_bot.db

# ==============================================================================
# VietQR Banking Configuration (For generating payment QR codes)
# Bank IDs: MB, VCB, TCB, ICB, ACB, VPB, TPB, BIDV, OCB, VIB, STB, ...
# ==============================================================================
BANK_ID=MB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A

# ==============================================================================
# Webhook Server Configuration (Auto payment confirmation & package delivery)
# ==============================================================================
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
SEPAY_API_KEY=your_optional_sepay_api_key_here
ADMIN_CHAT_ID=your_telegram_id_for_admin_alerts
